<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.bams22</groupId>
    <artifactId>event-outboxer-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>event-outboxer (parent)</name>
    <description>Embedded transactional outbox for Java 25+ / Spring Boot 3.5.6+ /
        PostgreSQL 15+ / Redis/keydb. Parent POM aggregating all modules.</description>
    <url>https://github.com/bams22/event-outboxer</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>bams22</id>
            <name>bams22</name>
            <url>https://github.com/bams22</url>
        </developer>
    </developers>

    <modules>
        <module>event-outboxer-bom</module>
        <module>event-outboxer-api</module>
        <module>event-outboxer-spi</module>
        <module>event-outboxer-core</module>
        <module>event-outboxer-storage-inmemory</module>
        <module>event-outboxer-storage-postgres</module>
        <module>event-outboxer-serializer-jackson</module>
        <module>event-outboxer-serializer-protobuf</module>
        <module>event-outboxer-lock-postgres-advisory</module>
        <module>event-outboxer-lock-postgres-lease</module>
        <!-- Relocation stub for the retired pre-0.3.0 coordinate; no code. -->
        <module>event-outboxer-lock-postgres</module>
        <module>event-outboxer-lock-redis</module>
        <module>event-outboxer-cache-redis</module>
        <module>event-outboxer-metrics-micrometer</module>
        <module>event-outboxer-tracing-otel</module>
        <module>event-outboxer-tracing-micrometer</module>
        <module>event-outboxer-admin-actuator</module>
        <module>event-outboxer-admin-rest</module>
        <module>event-outboxer-testkit</module>
        <module>event-outboxer-spring-boot-starter</module>
    </modules>

    <scm>
        <connection>scm:git:https://github.com/bams22/event-outboxer.git</connection>
        <developerConnection>scm:git:git@github.com:bams22/event-outboxer.git</developerConnection>
        <tag>HEAD</tag>
        <url>https://github.com/bams22/event-outboxer</url>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/bams22/event-outboxer/issues</url>
    </issueManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!--
            CI-friendly version (Maven 3.5+). Every module sets
            <version>${revision}</version>; the concrete value comes from here
            for local builds and from -Drevision=X.Y.Z for release builds
            driven by the tag-push workflow. flatten-maven-plugin resolves
            ${revision} into the published .flattened-pom.xml so consumers
            never see the property placeholder. Release runbook lives in
            RELEASING.md.
        -->
        <revision>0.4.0-SNAPSHOT</revision>

        <!-- Baseline Java 25 (LTS) — ADR-0017. -->
        <java.version>25</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <spring-boot.version>3.5.6</spring-boot.version>

        <!-- Plugin versions -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.5.3</maven-failsafe-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>3.2.7</maven-gpg-plugin.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
        <maven-deploy-plugin.version>3.1.3</maven-deploy-plugin.version>
        <!--
            Pin versions-maven-plugin below 2.19.0. Starting with 2.19.x the
            plugin bumped its transitive woodstox-core to 7.x while leaving
            stax2-api at 4.2.2, which lacks the StreamReader2Delegate class
            7.x expects — every invocation crashes with NoClassDefFoundError.
            2.16.2 is the last release without the broken combo.
        -->
        <versions-maven-plugin.version>2.16.2</versions-maven-plugin.version>
        <flatten-maven-plugin.version>1.7.0</flatten-maven-plugin.version>
        <spotless-maven-plugin.version>3.8.0</spotless-maven-plugin.version>
        <protobuf-maven-plugin.version>5.1.7</protobuf-maven-plugin.version>
        <!--
            Keep current: the plugin deserializes Sonatype's deployment-status
            response with FAIL_ON_UNKNOWN_PROPERTIES, so a field added on the
            server side breaks every older client. 0.6.0 died on the "warnings"
            field mid-release (upload had already succeeded, only the status
            poll crashed) — see RELEASING.md § Troubleshooting.
        -->
        <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>
        <japicmp-maven-plugin.version>0.23.1</japicmp-maven-plugin.version>
        <!--
            Baseline for japicmp API-compatibility reports: the latest release
            published to Maven Central. Bump on every release.
        -->
        <japicmp.baseline.version>0.3.0</japicmp.baseline.version>

        <!-- Non-Boot-managed test libs -->
        <testcontainers.version>1.20.4</testcontainers.version>
        <assertj.version>3.26.3</assertj.version>

        <!-- Nullness annotations (ADR-0018) -->
        <jspecify.version>1.0.0</jspecify.version>

        <!--
            Protobuf runtime — NOT managed by spring-boot-dependencies. protoc
            is pinned to the same version in the serializer-protobuf module
            (via the protobuf-maven-plugin pluginManagement below) so generated
            code and runtime never diverge: protobuf 4.x requires
            gencode <= runtime. ADR-0026.
        -->
        <protobuf.version>4.35.1</protobuf.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM: source of truth for Spring/Jackson/Micrometer/SLF4J/Logback versions -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Testcontainers (not in Boot BOM) -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- AssertJ (Boot BOM pins it, but kept here for explicitness) -->
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>

            <!-- JSpecify nullness annotations (ADR-0018) -->
            <dependency>
                <groupId>org.jspecify</groupId>
                <artifactId>jspecify</artifactId>
                <version>${jspecify.version}</version>
            </dependency>

            <!-- Protobuf runtime (not in Boot BOM) — ADR-0026 -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>

            <!-- Inter-module dependencies at project version -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>event-outboxer-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>event-outboxer-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>event-outboxer-spi</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>event-outboxer-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>event-outboxer-storage-inmemory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>event-outboxer-storage-postgres</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>event-outboxer-serializer-jackson</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>event-outboxer-serializer-protobuf</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>event-outboxer-lock-postgres-advisory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>event-outboxer-lock-postgres-lease</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>event-outboxer-lock-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>event-outboxer-cache-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>event-outboxer-metrics-micrometer</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>event-outboxer-tracing-otel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>event-outboxer-tracing-micrometer</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>event-outboxer-admin-actuator</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>event-outboxer-admin-rest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>event-outboxer-testkit</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                        <parameters>true</parameters>
                        <showWarnings>true</showWarnings>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven-source-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven-javadoc-plugin.version}</version>
                    <configuration>
                        <doclint>none</doclint>
                        <source>${java.version}</source>
                        <failOnWarnings>false</failOnWarnings>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>${maven-gpg-plugin.version}</version>
                    <configuration>
                        <gpgArguments>
                            <arg>--pinentry-mode</arg>
                            <arg>loopback</arg>
                        </gpgArguments>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>${versions-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>io.github.ascopes</groupId>
                    <artifactId>protobuf-maven-plugin</artifactId>
                    <version>${protobuf-maven-plugin.version}</version>
                    <configuration>
                        <!-- protoc pinned to the protobuf-java runtime version (ADR-0026) -->
                        <protoc kind="binary-maven">
                            <version>${protobuf.version}</version>
                        </protoc>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>${flatten-maven-plugin.version}</version>
                    <configuration>
                        <!--
                            resolveCiFriendliesOnly: substitute ${revision}/${sha1}/${changelist}
                            into the flattened pom but leave every other element (description,
                            licenses, scm, developers, plugin config) intact. Maven Central
                            requires all those fields to survive publication.
                        -->
                        <flattenMode>resolveCiFriendliesOnly</flattenMode>
                        <updatePomFile>true</updatePomFile>
                    </configuration>
                    <executions>
                        <execution>
                            <id>flatten</id>
                            <goals>
                                <goal>flatten</goal>
                            </goals>
                            <phase>process-resources</phase>
                        </execution>
                        <execution>
                            <id>flatten-clean</id>
                            <goals>
                                <goal>clean</goal>
                            </goals>
                            <phase>clean</phase>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless-maven-plugin.version}</version>
                    <configuration>
                        <java>
                            <googleJavaFormat>
                                <version>1.28.0</version>
                                <style>AOSP</style>
                                <reflowLongStrings>true</reflowLongStrings>
                            </googleJavaFormat>
                            <removeUnusedImports/>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </java>
                        <pom>
                            <sortPom>
                                <nrOfIndentSpace>4</nrOfIndentSpace>
                                <expandEmptyElements>false</expandEmptyElements>
                            </sortPom>
                        </pom>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>${central-publishing-maven-plugin.version}</version>
                    <extensions>true</extensions>
                    <configuration>
                        <publishingServerId>central</publishingServerId>
                        <autoPublish>false</autoPublish>
                        <waitUntil>validated</waitUntil>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.github.siom79.japicmp</groupId>
                    <artifactId>japicmp-maven-plugin</artifactId>
                    <version>${japicmp-maven-plugin.version}</version>
                    <configuration>
                        <oldVersion>
                            <dependency>
                                <groupId>io.github.bams22</groupId>
                                <artifactId>${project.artifactId}</artifactId>
                                <version>${japicmp.baseline.version}</version>
                                <type>jar</type>
                            </dependency>
                        </oldVersion>
                        <parameter>
                            <onlyModified>true</onlyModified>
                            <!--
                                Report-only until 1.0: pre-1.0 SPI breaks are intentional and
                                tracked in CHANGELOG [Unreleased]. When preparing 1.0, flip both
                                breakBuild* flags to true so verify fails on undeclared API
                                breaks, and keep japicmp.baseline.version at the latest release.
                            -->
                            <breakBuildOnBinaryIncompatibleModifications>false</breakBuildOnBinaryIncompatibleModifications>
                            <breakBuildOnSourceIncompatibleModifications>false</breakBuildOnSourceIncompatibleModifications>
                            <!--
                                Modules added after the baseline release have no old
                                artifact to compare against — skip them instead of failing
                                resolution. This also covers the window right after a
                                release, while Central finishes syncing the new baseline:
                                the report comes back empty for 15-30 minutes and then
                                heals itself.
                            -->
                            <ignoreMissingOldVersion>true</ignoreMissingOldVersion>
                            <skipPomModules>true</skipPomModules>
                        </parameter>
                    </configuration>
                    <executions>
                        <execution>
                            <id>api-compatibility-report</id>
                            <goals>
                                <goal>cmp</goal>
                            </goals>
                            <phase>verify</phase>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
                flatten-maven-plugin runs in every module: it resolves ${revision}
                at build time and writes .flattened-pom.xml, which the deploy
                plugin then installs/publishes in place of the raw pom. Config
                and execution bindings are inherited from pluginManagement above.
                BOM module overrides <flattenMode>bom</flattenMode> in its own pom.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9.0,)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                </requireJavaVersion>
                                <dependencyConvergence/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                japicmp compares every module's public API against the latest published
                release (japicmp.baseline.version) on verify and writes an HTML/XML report
                to target/japicmp/. Report-only until 1.0 — see the pluginManagement note.
            -->
            <plugin>
                <groupId>com.github.siom79.japicmp</groupId>
                <artifactId>japicmp-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Integration tests: activated with -P it; runs failsafe IT classes. -->
        <profile>
            <id>it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Release: source + javadoc + GPG signing + Sonatype Central publishing. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <phase>verify</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
