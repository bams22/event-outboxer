org.springframework.boot.env.EnvironmentPostProcessor=\
io.github.bams22.outboxer.spring.health.OutboxProbeGroupsEnvironmentPostProcessor,\
io.github.bams22.outboxer.spring.storage.OutboxLiquibaseParameterEnvironmentPostProcessor,\
io.github.bams22.outboxer.spring.metrics.OutboxMetricsDefaultsEnvironmentPostProcessor

org.springframework.boot.diagnostics.FailureAnalyzer=\
io.github.bams22.outboxer.spring.storage.OutboxStorageFailureAnalyzer,\
io.github.bams22.outboxer.spring.OutboxDataSourceFailureAnalyzer,\
io.github.bams22.outboxer.spring.OutboxHandlersFailureAnalyzer,\
io.github.bams22.outboxer.spring.redis.OutboxRedisConnectionFailureAnalyzer

org.springframework.boot.sql.init.dependency.DatabaseInitializerDetector=\
io.github.bams22.outboxer.spring.flyway.OutboxFlywayInitializerDetector
