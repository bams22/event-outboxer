<?xml version="1.0" encoding="UTF-8"?>
<!--
  event-outboxer entity-lock lease table, Liquibase variant. Mirrors the
  Flyway migration at event-outboxer/migration/lock/V005__outbox_entity_locks.sql
  by delegating to the same SQL file via <sqlFile>. Liquibase and Flyway
  share the ${eventOutboxerSchema} placeholder syntax, so one SQL file works
  for both.

  Usage (in addition to the core changelog):

    spring:
      liquibase:
        change-log: classpath:db/changelog/outbox/lock/changelog.xml

  The Spring Boot starter auto-wires the parameter eventOutboxerSchema from
  event-outboxer.storage.schema (default: event_outboxer). Plain-Java
  Liquibase users must set it themselves via
  -Dliquibase.parameter.eventOutboxerSchema=...,
  spring.liquibase.parameters.eventOutboxerSchema=..., or by calling
  Liquibase.setChangeLogParameter(...) programmatically.

  See docs/STORAGE.md §Configurable schema name and ADR-0022.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- Fallback default so the file is self-contained for users who do not
         wire the parameter explicitly (library default matches). The starter
         still overrides this via Liquibase parameters when present. -->
    <property name="eventOutboxerSchema" value="event_outboxer" dbms="postgresql"/>

    <changeSet id="outbox-lock-005-entity-locks" author="event-outboxer" dbms="postgresql">
        <sqlFile
            path="event-outboxer/migration/lock/V005__outbox_entity_locks.sql"
            relativeToChangelogFile="false"
            splitStatements="true"
            stripComments="false"
            endDelimiter=";"/>
    </changeSet>
</databaseChangeLog>
