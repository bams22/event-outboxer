# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

/.idea
target/
# `target/` above is meant for Maven build output, but it also matches a Java package
# directory named target — the benchmark harness has one (…/benchmark/target/, the
# system-under-test seam). Source trees are never build output: un-ignore them there.
!**/src/main/java/**/target/
!**/src/test/java/**/target/
*.iml

# flatten-maven-plugin: generated per-module pom with ${revision} resolved.
# Created during `mvn process-resources` / `install` / `deploy`, cleaned by
# `mvn clean`. Never committed.
.flattened-pom.xml

# This repo's docs/ADRs live in Markdown; override the user's global
# ~/.gitignore_global (which ignores *.md by default) for this repo only.
!*.md
!**/*.md

docs/notes
