<?xml version="1.0" encoding="UTF-8"?>
<!--
  event-outboxer optional archive table, Liquibase variant. Applied in addition
  to the core changelog when archiving is enabled. See ADR-0008 and
  docs/STORAGE.md.

  Usage (combine with core):

    spring:
      liquibase:
        change-log: classpath:db/changelog/outbox/master-with-archive.xml

  or include both files manually from your own master changelog.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <property name="eventOutboxerSchema" value="event_outboxer" dbms="postgresql"/>

    <changeSet id="outbox-archive-001" author="event-outboxer" dbms="postgresql">
        <sqlFile
            path="event-outboxer/migration/archive/V002__outbox_archive.sql"
            relativeToChangelogFile="false"
            splitStatements="true"
            stripComments="false"
            endDelimiter=";"/>
    </changeSet>

    <changeSet id="outbox-archive-007-payload-format" author="event-outboxer" dbms="postgresql">
        <sqlFile
            path="event-outboxer/migration/archive/V007__outbox_archive_payload_format.sql"
            relativeToChangelogFile="false"
            splitStatements="true"
            stripComments="false"
            endDelimiter=";"/>
    </changeSet>

    <changeSet id="outbox-archive-008-dedup-key" author="event-outboxer" dbms="postgresql">
        <sqlFile
            path="event-outboxer/migration/archive/V008__outbox_archive_dedup_key.sql"
            relativeToChangelogFile="false"
            splitStatements="true"
            stripComments="false"
            endDelimiter=";"/>
    </changeSet>

    <changeSet id="outbox-archive-009-replay-index" author="event-outboxer" dbms="postgresql">
        <sqlFile
            path="event-outboxer/migration/archive/V009__outbox_archive_replay_index.sql"
            relativeToChangelogFile="false"
            splitStatements="true"
            stripComments="false"
            endDelimiter=";"/>
    </changeSet>
</databaseChangeLog>
